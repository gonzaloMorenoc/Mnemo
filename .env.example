# ============================================================================
# Mnemo — variables de entorno (todas las que lee src/config.py y scripts/)
# Copia a .env y rellena. Las comentadas son opcionales o por-feature.
# ============================================================================

# --- BD + Auth (obligatorias para el modo multi-tenant) -----------------------
# DATABASE_URL: usar el Session pooler de Supabase (no la URL directa IPv6-only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Solo GoTrue self-hosted (HS256); en Supabase cloud dejar vacío (usa JWKS):
# SUPABASE_JWT_SECRET=

# --- LLM provider (intercambiable) --------------------------------------------
# Sin configurar (none): las funciones de IA degradan a su vía determinista — el
# triaje, las actas y el índice de continuidad no dependen del LLM.
# Opciones: none | ollama (local; el dato no sale) | openai (o compatible, p. ej.
# Groq/Gemini vía OPENAI_BASE_URL) | anthropic.
LLM_PROVIDER=none
LLM_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MAX_TOKENS=4096
# Proveedores comerciales: ENVÍAN datos de fallos (mensajes, trazas, nombres de test/proyecto)
# a un tercero. Solo si la política del cliente lo permite. Requiere opt-in explícito:
# ALLOW_EXTERNAL_LLM=true
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
#
# Ejemplo de PRODUCCIÓN con Groq (API compatible OpenAI; es lo que usa la demo):
#   LLM_PROVIDER=openai
#   ALLOW_EXTERNAL_LLM=true
#   OPENAI_API_KEY=<key de console.groq.com/keys>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
# Alternativa con Google Gemini (mismo LLM_PROVIDER=openai, clave de aistudio.google.com/apikey):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash

# --- Firma de actas (Ed25519) — sin esto el certificado está APAGADO ----------
# Generar: openssl genpkey -algorithm ed25519 -out priv.pem && openssl pkey -in priv.pem -pubout -out pub.pem
# Contenido PEM completo (con BEGIN/END). Ver docs/deploy/produccion.md.
# MNEMO_SIGNING_PRIVATE_KEY=
# MNEMO_SIGNING_PUBLIC_KEY=
# Tras rotar la clave: las públicas anteriores (PEM, una detrás de otra) para que las
# actas ya emitidas sigan verificando (se elige la clave por el key_id del acta).
# MNEMO_SIGNING_RETIRED_PUBLIC_KEYS=
# URL pública del frontend (p. ej. https://mnemo-beta-one.vercel.app). Solo se usa para el
# pie "verificable en …" del acta en PDF; vacía = el acta no imprime host.
# MNEMO_PUBLIC_APP_URL=

# --- Webhook de CI (ingesta automática /v2/ci/webhook) -------------------------
# CI_WEBHOOK_SECRET=          # secreto compartido HMAC-SHA256 (X-Hub-Signature-256)
# CI_SERVICE_USER_ID=         # UUID del usuario de servicio (miembro del org)
# CI_SERVICE_ORG_ID=          # opcional: fija el único org aceptado (403 al resto)

# --- Integraciones -------------------------------------------------------------
# Cifrado de credenciales Jira/Xray guardadas por-org (OBLIGATORIA si se usa Jira):
# clave Fernet — generar: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MNEMO_SECRET_KEY=
# GitHub App (gate en PR + self-heal PR):
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# --- Cotas y triaje (defaults sensatos; solo si necesitas cambiarlos) ----------
# INGEST_MAX_BYTES=10485760          # subidas de reportes/HU (10 MiB)
# CI_MAX_BODY_BYTES=10485760         # cuerpo del webhook de CI (10 MiB)
# TRIAGE_MASS_COFAILURE_MIN=3        # umbral de co-fallo masivo (señal infra)

# --- Init de demo (solo scripts/docker_init.py) ---------------------------------
# SERVICE_ROLE_KEY=            # service-role de Supabase (crea el usuario demo vía GoTrue)
# DEMO_EMAIL=demo@mnemo.local
# DEMO_PASSWORD=

# Jira y Confluence NO se configuran aquí: son integraciones por organización
# (app → Integraciones); el token se guarda cifrado (Fernet) en la BD.

# --- Embeddings de la memoria ---
# Modelo de embeddings (por defecto: multilingüe, 384 dims — el esquema es vector(384)).
# ⚠️ Si se cambia, ejecutar `python3 -m scripts.reembed` para regenerar los vectores
# existentes: mezclar modelos rompe la búsqueda y el merge de familias.
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Corte de distancia coseno de la búsqueda semántica (calibrado para el modelo por defecto).
# MAX_SEMANTIC_DISTANCE=0.75
