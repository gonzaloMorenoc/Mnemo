# Frontend de Mnemo — variables públicas (Next.js).
# Copia este archivo a .env.local (local) o configúralas en el proyecto de Vercel.
# Todas son NEXT_PUBLIC_* → se exponen al navegador; NO pongas aquí secretos del backend.

# URL del backend de Mnemo (FastAPI). En local suele ser http://localhost:8000.
# En Vercel, la URL pública del backend on-premise/desplegado.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Proyecto Supabase (auth de cliente).
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key>
